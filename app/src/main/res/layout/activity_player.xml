<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Opaque: hides the sniffer WebView behind it. Controls: res/layout/player_controls.xml -->
    <androidx.media3.ui.PlayerView android:id="@+id/player_view"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@android:color/black"
        app:use_controller="true"
        app:controller_layout_id="@layout/player_controls"
        app:time_bar_scrubbing_enabled="true"
        app:show_shuffle_button="false"
        app:shutter_background_color="@android:color/black"
        app:show_buffering="never"/>

    <ProgressBar android:id="@+id/buffering"
        android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
        android:indeterminateTint="#CCFFFFFF" android:visibility="gone"/>

    <!-- Double-tap seek feedback: YouTube-style half-moon on the tapped side -->
    <TextView android:id="@+id/seek_left"
        android:layout_width="300dp" android:layout_height="match_parent" android:layout_gravity="start"
        android:layout_marginStart="-120dp" android:layout_marginTop="-40dp" android:layout_marginBottom="-40dp"
        android:background="@drawable/seek_ripple" android:gravity="center" android:paddingStart="120dp"
        android:drawableTop="@drawable/ic_replay10" android:drawablePadding="6dp"
        android:textColor="@color/nova_white" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:visibility="gone"/>
    <TextView android:id="@+id/seek_right"
        android:layout_width="300dp" android:layout_height="match_parent" android:layout_gravity="end"
        android:layout_marginEnd="-120dp" android:layout_marginTop="-40dp" android:layout_marginBottom="-40dp"
        android:background="@drawable/seek_ripple" android:gravity="center" android:paddingEnd="120dp"
        android:drawableTop="@drawable/ic_forward10" android:drawablePadding="6dp"
        android:textColor="@color/nova_white" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:visibility="gone"/>

    <!-- Brightness (left) / volume (right): vertical bars like MX / YouTube -->
    <LinearLayout android:id="@+id/side_left"
        android:layout_width="44dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical|start"
        android:layout_marginStart="40dp" android:background="@drawable/side_bar_bg" android:orientation="vertical"
        android:gravity="center_horizontal" android:paddingTop="12dp" android:paddingBottom="12dp" android:visibility="gone">
        <FrameLayout android:id="@+id/side_left_track" android:layout_width="4dp" android:layout_height="140dp" android:background="#40FFFFFF">
            <View android:id="@+id/side_left_fill" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_gravity="bottom" android:background="@color/nova_white"/>
        </FrameLayout>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="10dp" android:src="@drawable/ic_brightness"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/side_right"
        android:layout_width="44dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="40dp" android:background="@drawable/side_bar_bg" android:orientation="vertical"
        android:gravity="center_horizontal" android:paddingTop="12dp" android:paddingBottom="12dp" android:visibility="gone">
        <FrameLayout android:id="@+id/side_right_track" android:layout_width="4dp" android:layout_height="140dp" android:background="#40FFFFFF">
            <View android:id="@+id/side_right_fill" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_gravity="bottom" android:background="@color/nova_white"/>
        </FrameLayout>
        <ImageView android:id="@+id/side_right_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="10dp" android:src="@drawable/ic_volume"/>
        <TextView android:id="@+id/side_right_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/nova_white" android:textSize="10sp" android:visibility="gone"/>
    </LinearLayout>

    <!-- Gesture HUD: brightness / volume / seek / speed / zoom -->
    <LinearLayout android:id="@+id/gesture_hud"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="56dp"
        android:background="@drawable/pill_glass" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:visibility="gone">
        <ImageView android:id="@+id/hud_icon" android:layout_width="20dp" android:layout_height="20dp"/>
        <TextView android:id="@+id/hud_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:textColor="@color/nova_white" android:textSize="14sp"
            android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum"/>
        <ProgressBar android:id="@+id/hud_bar" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="120dp" android:layout_height="4dp" android:layout_marginStart="12dp"
            android:max="1000" android:progressDrawable="@drawable/seek_track"/>
    </LinearLayout>

    <!-- Screen locked: only this is reachable -->
    <ImageButton android:id="@+id/btn_unlock"
        android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center_vertical|start"
        android:layout_marginStart="24dp" android:background="@drawable/circle_glass" android:src="@drawable/ic_lock"
        android:contentDescription="Unlock" android:visibility="gone"/>

    <!-- Skip intro / credits -->
    <Button android:id="@+id/btn_skip"
        android:layout_width="wrap_content" android:layout_height="44dp"
        android:layout_gravity="bottom|end" android:layout_marginEnd="24dp" android:layout_marginBottom="104dp"
        android:background="@drawable/btn_overlay" android:paddingStart="22dp" android:paddingEnd="22dp"
        android:textAllCaps="false" android:textColor="@color/btn_overlay_text"
        android:textSize="15sp" android:fontFamily="sans-serif-medium" android:visibility="gone"/>

    <!-- Up next: still, title, countdown that fills the card -->
    <LinearLayout android:id="@+id/next_card"
        android:layout_width="320dp" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:layout_marginEnd="24dp" android:layout_marginBottom="96dp"
        android:background="@drawable/card_glass" android:orientation="vertical" android:padding="10dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <ImageView android:id="@+id/next_still" android:layout_width="112dp" android:layout_height="63dp"
                android:scaleType="centerCrop" android:background="#22FFFFFF"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Up next"
                    android:textColor="@color/nova_white70" android:textSize="11sp"/>
                <TextView android:id="@+id/next_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/nova_white" android:textSize="14sp" android:fontFamily="sans-serif-medium"
                    android:maxLines="2" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <FrameLayout android:id="@+id/next_play" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                android:background="@drawable/btn_primary" android:clickable="true" android:focusable="true">
                <ProgressBar android:id="@+id/next_countdown" style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000"
                    android:progressDrawable="@drawable/countdown_fill"/>
                <TextView android:id="@+id/next_play_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:drawableStart="@drawable/ic_play" android:drawablePadding="6dp"
                    android:drawableTint="#FF000000" android:text="Play" android:textColor="#FF000000"
                    android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
            </FrameLayout>
            <TextView android:id="@+id/next_dismiss" android:layout_width="wrap_content" android:layout_height="40dp"
                android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:background="@drawable/player_chip" android:text="Watch credits"
                android:textColor="@color/nova_white" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Episodes drawer (slides in from the right) -->
    <FrameLayout android:id="@+id/episodes_scrim"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#80000000" android:visibility="gone" android:clickable="true"/>
    <LinearLayout android:id="@+id/episodes_drawer"
        android:layout_width="380dp" android:layout_height="match_parent" android:layout_gravity="end"
        android:background="@drawable/drawer_bg" android:orientation="vertical" android:visibility="gone"
        android:clickable="true">
        <TextView android:id="@+id/episodes_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="18dp" android:paddingTop="18dp" android:paddingBottom="8dp"
            android:textColor="@color/nova_white" android:textSize="18sp" android:fontFamily="sans-serif-medium"/>
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none">
            <LinearLayout android:id="@+id/episodes_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="16dp"/>
        </ScrollView>
    </LinearLayout>

    <!-- Loading: the title's own backdrop instead of a black screen -->
    <FrameLayout android:id="@+id/loading_layer"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@android:color/black" android:clickable="true">
        <ImageView android:id="@+id/loading_backdrop"
            android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim"/>
        <ImageButton android:id="@+id/loading_close" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_margin="12dp" android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back" android:contentDescription="Close"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:orientation="vertical"
            android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:layout_marginBottom="32dp">
            <TextView android:id="@+id/loading_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/nova_white" android:textSize="26sp"
                android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"/>
            <TextView android:id="@+id/status_text"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:lineSpacingMultiplier="1.2"
                android:textColor="@color/nova_white70" android:textSize="14sp"/>
            <ProgressBar android:id="@+id/loading"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="240dp" android:layout_height="4dp" android:layout_marginTop="16dp"
                android:indeterminate="true" android:indeterminateTint="#FFFFFFFF"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="18dp">
                <Button android:id="@+id/btn_retry"
                    android:layout_width="wrap_content" android:layout_height="44dp"
                    android:background="@drawable/btn_overlay" android:text="Retry"
                    android:drawableStart="@drawable/ic_retry" android:drawablePadding="8dp" android:drawableTint="@color/nova_white"
                    android:paddingStart="22dp" android:paddingEnd="26dp"
                    android:textAllCaps="false" android:textColor="@color/btn_overlay_text"
                    android:textSize="15sp" android:fontFamily="sans-serif-medium" android:visibility="gone"/>
                <Button android:id="@+id/btn_pick_source"
                    android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="10dp"
                    android:background="@drawable/btn_overlay" android:text="Choose source"
                    android:paddingStart="22dp" android:paddingEnd="22dp"
                    android:textAllCaps="false" android:textColor="@color/btn_overlay_text"
                    android:textSize="15sp" android:fontFamily="sans-serif-medium" android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
