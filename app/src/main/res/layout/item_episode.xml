<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="8dp" android:paddingBottom="8dp"
    android:clickable="true" android:foreground="?android:attr/selectableItemBackground">

    <FrameLayout android:id="@+id/ep_frame"
        android:layout_width="136dp" android:layout_height="77dp" android:background="@drawable/skeleton">
        <ImageView android:id="@+id/ep_still" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
        <TextView android:id="@+id/ep_number" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:textColor="@color/nova_white40" android:textSize="22sp" android:fontFamily="sans-serif-light"/>
        <View android:id="@+id/ep_dim" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#66000000" android:visibility="gone"/>
        <TextView android:id="@+id/ep_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_margin="5dp" android:background="@drawable/badge_pill"
            android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:textColor="@color/nova_white" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:visibility="gone"/>
        <ProgressBar android:id="@+id/ep_progress" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_gravity="bottom" android:layout_margin="6dp"
            android:max="1000" android:progressDrawable="@drawable/progress_track" android:visibility="gone"/>
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp" android:layout_gravity="center_vertical">
        <TextView android:id="@+id/ep_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/nova_white" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"
            android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/ep_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp" android:visibility="gone"/>
        <TextView android:id="@+id/ep_desc" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/nova_white40" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Download: ↓ → ring with progress → ✓ -->
    <com.anees.novamobile.ui.downloads.ProgressRing android:id="@+id/ep_dl"
        android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center_vertical"
        android:layout_marginStart="4dp" android:padding="9dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"/>
</LinearLayout>
