<?xml version="1.0" encoding="utf-8"?>
<!-- Downloads: one item inside the "Downloading" card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="12dp" android:paddingEnd="6dp" android:paddingTop="8dp" android:paddingBottom="8dp"
    android:background="@color/nova_surface" android:clickable="true"
    android:foreground="?android:attr/selectableItemBackground">
    <!-- Bulk select mode -->
    <CheckBox android:id="@+id/a_check" android:layout_width="32dp" android:layout_height="32dp"
        android:layout_marginEnd="6dp" android:buttonTint="@color/nova_accent" android:clickable="false"
        android:focusable="false" android:visibility="gone"/>
    <ImageView android:id="@+id/a_poster" android:layout_width="40dp" android:layout_height="60dp"
        android:scaleType="centerCrop" android:background="@drawable/skeleton"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/a_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/nova_white" android:textSize="14sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/a_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#99FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
            android:fontFeatureSettings="tnum"/>
    </LinearLayout>
    <com.anees.novamobile.ui.downloads.ProgressRing android:id="@+id/a_ring"
        android:layout_width="44dp" android:layout_height="44dp" android:padding="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"/>
</LinearLayout>
