{
  "version": 1,
  "note": "Nova TV stream sources. Edit and push: the app picks this up on next start. {id} = TMDB id, {s}/{e} = season/episode.",
  "sources": [
    {
      "name": "Vidly",
      "movie": "https://vidly.pro/movie/{id}",
      "tv": "https://vidly.pro/tv/{id}/{s}/{e}",
      "timeoutMs": 20000,
      "multiAudio": true,
      "enabled": true
    },
    {
      "name": "OllyEmbed",
      "movie": "https://ollyembed.pages.dev/movie/{id}?server=2",
      "tv": "https://ollyembed.pages.dev/tv/{id}/{s}/{e}?server=2",
      "timeoutMs": 20000,
      "multiAudio": true,
      "enabled": false
    },
    {
      "name": "VidFast",
      "movie": "https://vidfast.pro/movie/{id}?autoPlay=true",
      "tv": "https://vidfast.pro/tv/{id}/{s}/{e}?autoPlay=true",
      "timeoutMs": 15000,
      "multiAudio": false,
      "enabled": true
    }
  ]
}
