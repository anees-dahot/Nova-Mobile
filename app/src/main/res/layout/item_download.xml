<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
    android:background="@color/nova_black" android:clickable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <FrameLayout android:id="@+id/dl_frame" android:layout_width="120dp" android:layout_height="68dp" android:background="@drawable/skeleton">
        <ImageView android:id="@+id/dl_thumb" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/dl_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/nova_white" android:textSize="15sp" android:fontFamily="sans-serif-medium"
            android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/dl_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#99FFFFFF" android:textSize="13sp" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>

    <com.anees.novamobile.ui.downloads.ProgressRing android:id="@+id/dl_ring"
        android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp"
        android:padding="6dp" android:background="?android:attr/selectableItemBackgroundBorderless"/>
</LinearLayout>
