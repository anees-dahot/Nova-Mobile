<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NovaTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/nova_black</item>
        <item name="android:colorBackground">@color/nova_black</item>
        <item name="android:textColorPrimary">@color/nova_white</item>
        <item name="android:textColorSecondary">@color/nova_white70</item>
        <item name="colorPrimary">@color/nova_accent</item>
        <item name="colorPrimaryDark">@color/nova_black</item>
        <item name="colorAccent">@color/nova_accent</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/nova_black</item>
        <item name="android:navigationBarColor">@color/nova_black</item>
    </style>

    <style name="Theme.NovaTV.Player" parent="Theme.NovaTV">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:keepScreenOn">true</item>
    </style>

    <!-- Card focus animation style -->
    <style name="NovaCard">
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:stateListAnimator">@animator/card_focus</item>
    </style>
    <!-- Quiet text buttons under the player's time bar -->
    <style name="PlayerTextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/nova_white</item>
        <item name="android:background">@drawable/text_button</item>
        <item name="android:textColor">@color/nova_white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Quick buttons under the player's time bar -->
    <style name="PlayerChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/nova_white</item>
        <item name="android:background">@drawable/player_chip</item>
        <item name="android:textColor">@color/nova_white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

</resources>
