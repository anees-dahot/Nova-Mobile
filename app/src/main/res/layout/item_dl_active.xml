<?xml version="1.0" encoding="utf-8"?>
<!-- Downloads: one unfinished download, its own card (poster · title · tags · progress · stats · pause/resume) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="8dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="10dp" android:paddingEnd="4dp" android:paddingTop="10dp" android:paddingBottom="10dp"
    android:background="@color/nova_surface" android:clickable="true"
    android:foreground="?android:attr/selectableItemBackground">
    <!-- Bulk select mode -->
    <CheckBox android:id="@+id/a_check" android:layout_width="32dp" android:layout_height="32dp"
        android:layout_marginEnd="6dp" android:buttonTint="@color/nova_accent" android:clickable="false"
        android:focusable="false" android:visibility="gone"/>
    <ImageView android:id="@+id/a_poster" android:layout_width="52dp" android:layout_height="78dp"
        android:scaleType="centerCrop" android:background="@drawable/skeleton"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/a_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/nova_white" android:textSize="15sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/a_tags" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#80FFFFFF" android:textSize="11.5sp" android:maxLines="1"
            android:ellipsize="end" android:letterSpacing="0.02"/>
        <ProgressBar android:id="@+id/a_bar" style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp"
            android:max="1000" android:progressTint="@color/nova_accent" android:progressBackgroundTint="#33FFFFFF"
            android:indeterminateTint="@color/nova_accent"/>
        <TextView android:id="@+id/a_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
            android:fontFeatureSettings="tnum"/>
    </LinearLayout>
    <com.anees.novamobile.ui.downloads.ProgressRing android:id="@+id/a_ring"
        android:layout_width="48dp" android:layout_height="48dp" android:padding="9dp" android:layout_marginStart="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"/>
</LinearLayout>
