<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/nova_black" android:clickable="true">

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="32dp">

            <!-- 16:9 backdrop with fade into the page -->
            <FrameLayout android:id="@+id/detail_header"
                android:layout_width="match_parent" android:layout_height="240dp">
                <ImageView android:id="@+id/detail_backdrop"
                    android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_bottom"/>
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginTop="-40dp">

                <TextView android:id="@+id/detail_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/nova_white" android:textSize="28sp"
                    android:fontFamily="sans-serif-medium" android:letterSpacing="-0.02" android:maxLines="3" android:ellipsize="end"/>
                <TextView android:id="@+id/detail_meta"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/nova_white70" android:textSize="12sp" android:layout_marginTop="6dp"/>

                <Button android:id="@+id/detail_play"
                    android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="16dp"
                    android:textAllCaps="false" android:textColor="#FF000000" android:fontFamily="sans-serif-medium"
                    android:background="@drawable/btn_play_hero" android:textSize="16sp"/>
                <ProgressBar android:id="@+id/detail_loading"
                    android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp" android:indeterminateTint="@color/nova_white" android:visibility="gone"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">
                    <Button android:id="@+id/detail_list"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
                        android:textAllCaps="false" android:textColor="@color/nova_white"
                        android:background="@drawable/btn_secondary" android:textSize="14sp"/>
                    <Button android:id="@+id/detail_trailer"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
                        android:layout_marginStart="10dp" android:text="▶  Trailer"
                        android:textAllCaps="false" android:textColor="@color/nova_white"
                        android:background="@drawable/btn_secondary" android:textSize="14sp"/>
                    <Button android:id="@+id/detail_download"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
                        android:layout_marginStart="10dp" android:text="⬇  Download"
                        android:textAllCaps="false" android:textColor="@color/nova_white"
                        android:background="@drawable/btn_secondary" android:textSize="14sp"/>
                </LinearLayout>

                <TextView android:id="@+id/detail_overview"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/nova_white70" android:textSize="14sp" android:lineSpacingMultiplier="1.25"
                    android:layout_marginTop="16dp" android:maxLines="4" android:ellipsize="end"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/episode_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="22dp" android:visibility="gone">
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:scrollbars="none" android:paddingStart="16dp" android:clipToPadding="false">
                    <LinearLayout android:id="@+id/season_chips"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
                <TextView android:id="@+id/download_season"
                    android:layout_width="wrap_content" android:layout_height="34dp"
                    android:layout_marginStart="16dp" android:layout_marginTop="10dp"
                    android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:background="@drawable/btn_secondary" android:text="⬇  Download Season"
                    android:textColor="@color/nova_white" android:textSize="13sp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/episode_list"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <TextView android:id="@+id/related_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:paddingStart="16dp"
                android:text="More Like This" android:visibility="gone"
                android:textColor="#E6FFFFFF" android:textSize="16sp" android:fontFamily="sans-serif-medium"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/related_list"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp"
                android:clipToPadding="false"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageButton android:id="@+id/detail_back"
        android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="12dp"
        android:background="@drawable/circle_glass" android:src="@drawable/ic_back" android:contentDescription="Back"/>
</FrameLayout>
