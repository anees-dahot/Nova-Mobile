<?xml version="1.0" encoding="utf-8"?>
<!-- Nova's control layer for Media3's PlayerView (exo_* ids are wired by PlayerControlView itself) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/player_scrim">

    <!-- Top: back · title / episode + "ends at" · PiP · lock · more -->
    <LinearLayout android:id="@+id/player_top"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="8dp">
        <ImageButton android:id="@+id/btn_back" android:layout_width="44dp" android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" android:contentDescription="Back"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="4dp">
            <TextView android:id="@+id/top_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/nova_white" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/top_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <ImageButton android:id="@+id/btn_pip" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
            android:scaleType="fitCenter" android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pip" android:contentDescription="Picture in picture"/>
        <ImageButton android:id="@+id/btn_lock" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
            android:scaleType="fitCenter" android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_lock_open" android:contentDescription="Lock screen"/>
        <ImageButton android:id="@+id/btn_options" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
            android:scaleType="fitCenter" android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more" android:contentDescription="More"/>
    </LinearLayout>

    <!-- Center: −10 · play/pause · +10, one family of round buttons -->
    <LinearLayout android:id="@+id/center_controls"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btn_rew10" android:layout_width="56dp" android:layout_height="56dp"
            android:background="@drawable/circle_control" android:src="@drawable/ic_replay10"
            android:scaleType="fitCenter" android:padding="14dp" android:contentDescription="Back 10 seconds"/>
        <ImageButton android:id="@id/exo_play_pause" android:layout_width="72dp" android:layout_height="72dp"
            android:layout_marginStart="48dp" android:layout_marginEnd="48dp"
            android:background="@drawable/circle_control" android:scaleType="fitCenter" android:padding="18dp"
            app:tint="@color/nova_white" android:contentDescription="Play or pause"/>
        <ImageButton android:id="@+id/btn_fwd10" android:layout_width="56dp" android:layout_height="56dp"
            android:background="@drawable/circle_control" android:src="@drawable/ic_forward10"
            android:scaleType="fitCenter" android:padding="14dp" android:contentDescription="Forward 10 seconds"/>
    </LinearLayout>

    <!-- Bottom: time · bar · time left, then quiet text buttons + Next Episode -->
    <LinearLayout android:id="@+id/exo_bottom_bar"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@id/exo_position" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:textColor="@color/nova_white" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"/>
            <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="26dp"
                android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                app:played_color="@color/nova_accent" app:scrubber_color="@color/nova_white"
                app:buffered_color="#59FFFFFF" app:unplayed_color="#33FFFFFF"
                app:bar_height="3dp" app:scrubber_enabled_size="12dp" app:scrubber_dragged_size="18dp"/>
            <TextView android:id="@+id/time_remaining" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:gravity="end" android:textColor="@color/nova_white" android:textSize="12sp"
                android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/btn_speed" style="@style/PlayerTextButton" android:text="1×" android:drawableStart="@drawable/ic_speed"/>
            <TextView android:id="@+id/btn_tracks" style="@style/PlayerTextButton" android:text="Audio &amp; Subtitles" android:drawableStart="@drawable/ic_subtitles"/>
            <TextView android:id="@+id/btn_quality" style="@style/PlayerTextButton" android:text="Auto" android:drawableStart="@drawable/ic_hd"/>
            <TextView android:id="@+id/btn_episodes" style="@style/PlayerTextButton" android:text="Episodes" android:drawableStart="@drawable/ic_episodes" android:visibility="gone"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <TextView android:id="@+id/btn_next_ep" android:layout_width="wrap_content" android:layout_height="36dp"
                android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="16dp"
                android:background="@drawable/pill_white" android:text="Next Episode" android:textColor="#FF000000"
                android:textSize="13sp" android:fontFamily="sans-serif-medium"
                android:drawableStart="@drawable/ic_skip_next" android:drawablePadding="4dp" android:drawableTint="#FF000000"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
