<?xml version="1.0" encoding="utf-8"?>
<!-- Only the top and bottom darken (title + time bar readable); the picture itself stays bright -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top" android:height="130dp"><shape><gradient android:angle="270" android:startColor="#A6000000" android:endColor="#00000000"/></shape></item>
    <item android:gravity="bottom" android:height="190dp"><shape><gradient android:angle="90" android:startColor="#C0000000" android:centerColor="#66000000" android:endColor="#00000000"/></shape></item>
</layer-list>
